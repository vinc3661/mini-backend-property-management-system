
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TypeScript Server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
          "--inspect",
        "--enable-source-maps",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/src/server.ts",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
